<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RoslynAnalysersVersion>5.1.4</RoslynAnalysersVersion>
    <PrimitivesVersion>9.0.0</PrimitivesVersion>
    <MicrosoftRuntimePackageVersion>10.0.13</MicrosoftRuntimePackageVersion>
    <MicrosoftRuntimePackageVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.32</MicrosoftRuntimePackageVersion>
    <MicrosoftRuntimePackageVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.21</MicrosoftRuntimePackageVersion>
    <MicrosoftRuntimePackageVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0-rc.2.26504.105</MicrosoftRuntimePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CP.Nuke.BuildTools" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="$(PrimitivesVersion)" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="$(PrimitivesVersion)" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynAnalysersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynAnalysersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynAnalysersVersion)" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
  </ItemGroup>
</Project>
